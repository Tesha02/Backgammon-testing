{
  "name": "tests",
  "version": "1.0.0",
  "description": "Playwright API, UI and two-player E2E tests for the local Backgammon application",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:headed": "playwright test --project=ui-chromium --headed",
    "test:e2e": "playwright test --project=e2e-chromium",
    "test:e2e:headed": "playwright test --project=e2e-chromium --headed",
    "test:ui-mode": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
